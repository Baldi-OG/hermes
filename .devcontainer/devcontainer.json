{
  "name": "forensic linguist agent env",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt && python -m spacy download en_core_web_sm && bash download_datasets.sh",

  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],

  "customizations": {
    "vscode": {
      "extensions": [
        "Continue.continue",
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter"
      ],
      "settings": {
      "python.envFile": "${workspaceFolder}/.env",
      "python.terminal.useEnvFile": true
    }
    }
  }
}